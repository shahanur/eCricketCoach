{
  "name": "ecricketcoach-server",
  "version": "1.0.0",
  "description": "eCricketCoach Containerized Node.js Backend API",
  "main": "dist/index.js",
  "scripts": {
    "test:auth": "tsx --test src/routes/auth.test.ts src/utils/googleIdentity.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:training-templates": "tsx --test src/routes/trainingTemplates.test.ts",
    "test:drill-images": "tsx --test src/routes/drillImages.test.ts",
    "test:global-drills": "tsx --test src/routes/globalDrills.test.ts",
    "db:reset": "tsx src/scripts/resetDb.ts --yes"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.9",
    "prisma": "5.22.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
