# Comma-separated browser-facing origins; the one matching the request host is used for OAuth redirects.
APP_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=shahanurreza@gmail.com

# Register http://localhost:3000/api/auth/<provider>/callback with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# CAPE computer-vision analysis (internal service; see cape-api/). Leave CAPE_API_URL empty to disable.
REDIS_URL=redis://localhost:6379
CAPE_API_URL=
CAPE_API_KEY=
CAPE_TIMEOUT_MS=600000
# Number of videos analysed at once (= GPU slots).
CAPE_CONCURRENCY=1
# Run the queue worker inside the API process instead of a separate `npm run worker` process.
CAPE_WORKER_ENABLED=false
# Add a Gemini-written plain-language summary of CAPE's findings.
CAPE_GEMINI_SUMMARY=false
# Shared by the API and worker; defaults to <os tmpdir>/cape-uploads.
CAPE_UPLOAD_DIR=
