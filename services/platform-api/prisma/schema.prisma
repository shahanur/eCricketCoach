generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CustomerTenant {
  id               String   @id
  name             String
  type             String
  email            String
  logoUrl          String?  @map("logo_url") @db.Text
  subscriptionPlan String   @map("subscription_plan")
  status           String
  billingCycle     String   @map("billing_cycle")
  mrr              Decimal  @default(0) @db.Decimal(10, 2)
  activeMembers    Int      @default(1) @map("active_members")
  joinedAt         String   @map("joined_at")
  developmentPlayerSubscription PlayerDevelopmentSubscription?
  playerProfile    PlayerProfile?
  dashboardDemo    PlayerDashboardDemo?

  @@map("customer_tenants")
}

model PlayerProfile {
  id                 String   @id
  tenantId           String   @unique @map("tenant_id")
  ownerEmail         String   @unique @map("owner_email")
  displayName        String   @map("display_name")
  battingHandedness  String   @map("batting_handedness")
  bowlingStyle       String   @map("bowling_style")
  primaryDisciplines String[] @default([]) @map("primary_disciplines")
  experienceLevel    String   @map("experience_level")
  goals              String[] @default([])
  version            Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             CustomerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roadmap            PlayerRoadmap?

  @@map("player_profiles")
}

model PlayerRoadmap {
  profileId           String @id @map("profile_id")
  version             Int @default(0)
  answers             Json @default("{}")
  generatingKey       String? @map("generating_key")
  generationStartedAt DateTime? @map("generation_started_at") @db.Timestamptz(3)
  profile             PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  revisions           PlayerRoadmapRevision[]
  practice            PlayerRoadmapPractice[]

  @@map("player_roadmaps")
}

model PlayerRoadmapRevision {
  id            String @id
  profileId     String @map("profile_id")
  requestId     String @map("request_id")
  inputVersion  Int @map("input_version")
  profileVersion Int @map("profile_version")
  snapshot      Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  roadmap       PlayerRoadmap @relation(fields: [profileId], references: [profileId], onDelete: Cascade)
  practice      PlayerRoadmapPractice[]

  @@unique([profileId, requestId])
  @@index([profileId, createdAt])
  @@map("player_roadmap_revisions")
}

model PlayerRoadmapPractice {
  id          String @id
  profileId   String @map("profile_id")
  requestId   String @map("request_id")
  revisionId  String @map("revision_id")
  drillId     String @map("drill_id")
  discipline  String
  minutes     Int
  reflection  String
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  roadmap     PlayerRoadmap @relation(fields: [profileId], references: [profileId], onDelete: Cascade)
  revision    PlayerRoadmapRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([profileId, requestId])
  @@unique([profileId, revisionId, drillId])
  @@index([profileId, completedAt])
  @@map("player_roadmap_practice")
}

model PlayerDashboardDemo {
  tenantId        String   @id @map("tenant_id")
  ownerEmail      String   @unique @map("owner_email")
  progressPercent Int      @map("progress_percent")
  stage           String
  focusTitle      String   @map("focus_title")
  focusDiscipline String   @map("focus_discipline")
  focusMinutes    Int      @map("focus_minutes")
  focusDescription String  @map("focus_description")
  notification    String
  tenant          CustomerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("player_dashboard_demos")
}

model PlayerDevelopmentSubscription {
  tenantId   String   @id @map("tenant_id")
  ownerEmail String   @unique @map("owner_email")
  approvalId String   @unique @map("approval_id")
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  tenant     CustomerTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approval   ClubApproval @relation(fields: [approvalId], references: [id])

  @@map("player_development_subscriptions")
}

model Invoice {
  id           String  @id
  tenantId     String  @map("tenant_id")
  customerName String  @map("customer_name")
  amount       Decimal @db.Decimal(10, 2)
  currency     String  @default("USD")
  status       String
  date         String  @map("invoice_date")
  planName     String  @map("plan_name")

  @@map("invoices")
}

model AdminNotification {
  id        String  @id
  title     String
  message   String
  type      String
  timestamp String
  read      Boolean @default(false) @map("is_read")

  @@map("admin_notifications")
}

model ClubApproval {
  id           String  @id
  clubName     String  @map("club_name")
  adminName    String  @map("admin_name")
  adminEmail   String  @map("admin_email")
  plan         String
  amountPaid   Decimal @map("amount_paid") @db.Decimal(10, 2)
  type         String
  billingCycle String  @map("billing_cycle")
  status       String
  createdAt    String  @map("created_at")
  developmentPlayerSubscription PlayerDevelopmentSubscription?

  @@map("club_approvals")
}

model Drill {
  id           String  @id
  title        String
  discipline   String
  skillSet     String  @map("skill_set")
  contextType  String  @map("context_type")
  duration     Int     @default(20)
  source       String
  clubId       String? @map("club_id")
  clubName     String? @map("club_name")
  squadId      String? @map("squad_id")
  squadName    String? @map("squad_name")
  instructions String?
  imageUrl     String? @map("image_url")
  image        DrillImage?

  @@map("drills")
}

model DrillImage {
  drillId  String @id @map("drill_id")
  data     Bytes  @db.ByteA
  mimeType String @map("mime_type")
  drill    Drill  @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@map("drill_images")
}

model ClubMember {
  id               String  @id
  clubId           String? @map("club_id")
  name             String
  email            String
  role             String
  ageGroup         String  @map("age_group")
  discipline       String
  invitationStatus String  @map("invitation_status")
  currentLevel     String  @map("current_level")
  squad            String  @default("Unassigned")
  squads           String[] @default([])

  @@map("club_members")
}

model Squad {
  id          String  @id
  clubId      String? @map("club_id")
  name        String
  ageGroup    String  @map("age_group")
  discipline  String
  memberCount Int     @default(0) @map("member_count")

  @@map("squads")
}

model TrainingSessionTemplate {
  id              String   @id
  title           String
  activityName    String   @map("activity_name")
  disciplines     String[]
  focus           String   @db.Text
  organization    String   @db.Text
  safety          String[]
  durationMinutes Int      @map("duration_minutes")
  drillIds        String[] @map("drill_ids")

  @@map("training_session_templates")
}

model TrainingSession {
  id              String   @id
  clubId          String?  @map("club_id")
  squadId         String?  @map("squad_id")
  squadName       String   @map("squad_name")
  coachId         String?  @map("coach_id")
  coachName       String?  @map("coach_name")
  coordinatorCoachId   String?  @map("coordinator_coach_id")
  coordinatorCoachName String?  @map("coordinator_coach_name")
  assistantCoachId     String?  @map("assistant_coach_id")
  assistantCoachName   String?  @map("assistant_coach_name")
  assignedPlayerIds Json?  @default("[]") @map("assigned_player_ids")
  title           String
  sessionDate     String   @map("session_date")
  sessionTime     String?  @map("session_time")
  durationMinutes Int      @default(90) @map("duration_minutes")
  safety          String[] @default([])
  isPublished     Boolean  @default(false) @map("is_published")
  isExecuted      Boolean  @default(false) @map("is_executed")
  drillCount      Int      @default(0) @map("drill_count")
  drillIds        Json?    @default("[]") @map("drill_ids")
  playerNotes     Json?    @default("{}") @map("player_notes")
  postNotes       String?  @map("post_notes")
  aiEvaluation    Json?    @map("ai_evaluation")
  executionLog    Json?    @map("execution_log")
  observations    SessionObservation[]

  @@map("training_sessions")
}

model SessionObservation {
  id         String         @id
  sessionId  String         @map("session_id")
  clubId     String         @map("club_id")
  coachId    String         @map("coach_id")
  playerId   String?        @map("player_id")
  playerName String?        @map("player_name")
  scope      String
  category   String
  text       String         @db.Text
  drillId    String?        @map("drill_id")
  drillTitle String?        @map("drill_title")
  createdAt  DateTime       @default(now()) @map("created_at")
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("session_observations")
}

model PlayerAssessment {
  id                String    @id
  clubId            String    @map("club_id")
  playerId          String    @map("player_id")
  playerName        String    @map("player_name")
  coachId           String    @map("coach_id")
  coachName         String    @map("coach_name")
  title             String
  discipline        String
  scheduledDate     String    @map("scheduled_date")
  scheduledTime     String?   @map("scheduled_time")
  status            String    @default("SCHEDULED")
  metrics           Json      @default("[]")
  strengths         String    @default("") @db.Text
  focusAreas        String    @default("") @map("focus_areas") @db.Text
  coachFeedback     String    @default("") @map("coach_feedback") @db.Text
  playerFeedback    String    @default("") @map("player_feedback") @db.Text
  trainingSessionId String?   @map("training_session_id")
  videoAnalysisId   String?   @map("video_analysis_id")
  aiInsights        Json?     @map("ai_insights")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([clubId, playerId, scheduledDate])
  @@index([clubId, coachId, status])
  @@map("player_assessments")
}

model Certificate {
  id                String  @id
  certificateNumber String  @unique @map("certificate_number")
  playerId          String? @map("player_id")
  clubId            String? @map("club_id")
  clubName          String? @map("club_name")
  clubLogo          String? @map("club_logo") @db.Text
  playerName        String  @map("player_name")
  discipline        String
  achievedLevel     String  @map("achieved_level")
  issuedDate        String  @map("issued_date")
  coachName         String  @map("coach_name")
  coachNotes        String? @map("coach_notes")
  aiCommendation    String? @map("ai_commendation")

  @@map("certificates")
}

model SupportTicket {
  id          String   @id
  ticketRef   String   @unique @map("ticket_ref")
  name        String
  email       String
  category    String
  priority    String   @default("NORMAL")
  subject     String
  message     String
  status      String   @default("OPEN")
  tenantRole  String?  @map("tenant_role")
  clubName    String?  @map("club_name")
  resolution  String?
  resolvedBy  String?  @map("resolved_by")
  resolvedAt  String?  @map("resolved_at")
  createdAt   String   @map("created_at")

  @@map("support_tickets")
}

model GoogleDriveConnection {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  email        String
  accessToken  String    @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  expiryDate   BigInt?   @map("expiry_date")
  scope        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("google_drive_connections")
}

model VideoAnalysis {
  id               String   @id @default(cuid())
  userId           String?  @map("user_id")
  playerId         String?  @map("player_id")
  playerName       String?  @map("player_name")
  discipline       String
  context          String
  sourceType       String   @map("source_type")
  driveFileId      String?  @map("drive_file_id")
  model            String
  overallScore     Int      @map("overall_score")
  analysis         Json
  drillAdopted     Boolean  @default(false) @map("drill_adopted")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("video_analyses")
}

// One CAPE (computer-vision) analysis run. Status: QUEUED | RUNNING | SUCCEEDED | FAILED.
model CapeJob {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  createdById  String   @map("created_by_id")
  playerId     String?  @map("player_id")
  playerName   String?  @map("player_name")
  assessmentId String?  @map("assessment_id")
  driveFileId  String?  @map("drive_file_id")
  // Staged device upload (shared upload dir); removed once the job reaches a final state.
  uploadPath   String?  @map("upload_path")
  request      Json
  status       String   @default("QUEUED")
  error        String?
  result       Json?
  // { "<artifact file name>": "<Drive file id>" }
  artifacts    Json?
  // Audit of the Gemini coaching-guidance call: prompt, facts, model, outcome.
  geminiRequest Json?   @map("gemini_request")
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@map("cape_jobs")
}

model OpenAiBattingReport {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  createdById     String   @map("created_by_id")
  playerId        String?  @map("player_id")
  playerName      String?  @map("player_name")
  assessmentId    String?  @map("assessment_id")
  sourceSha256    String   @map("source_sha256")
  sourceType      String?  @map("source_type")
  sourceName      String?  @map("source_name")
  model           String
  promptVersion   String   @map("prompt_version")
  schemaVersion   String   @map("schema_version")
  artifactKey     String   @map("artifact_key")
  artifacts       Json
  analysis        Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, playerId, createdAt])
  @@index([tenantId, assessmentId, createdAt])
  @@map("openai_batting_reports")
}

// A drill a coach assigned to one player, e.g. from a CAPE analysis's coaching guidance.
// `drillId` is the club catalogue copy; `systemDrillId` the shared SYSTEM_PREDEFINED copy.
model PlayerDrillAssignment {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  playerId       String   @map("player_id")
  playerName     String   @map("player_name")
  drillId        String   @map("drill_id")
  systemDrillId  String?  @map("system_drill_id")
  capeJobId      String?  @map("cape_job_id")
  faultCode      String?  @map("fault_code")
  title          String
  discipline     String
  // { why_it_matters, coaching_cues, instructions, equipment }
  details        Json
  assignedById   String   @map("assigned_by_id")
  assignedByName String?  @map("assigned_by_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([capeJobId, faultCode])
  @@index([tenantId, playerId, createdAt])
  @@map("player_drill_assignments")
}
